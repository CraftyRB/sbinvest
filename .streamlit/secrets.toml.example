# Copy these keys into the Streamlit Cloud app's "Secrets" box
# (Share > Settings > Secrets). Locally they live in env.txt instead.

CEREBRAS_API_KEY = "csk-..."
DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/..."
DISCORD_PORTFOLIO_WEBHOOK_URL = "https://discord.com/api/webhooks/..."

# Persistent storage - required on Streamlit Community Cloud, whose container
# filesystem is wiped on sleep/redeploy. Leave these out locally.
TURSO_DATABASE_URL = "libsql://<your-db>-<org>.turso.io"
TURSO_AUTH_TOKEN = "<token from `turso db tokens create <db>`>"
